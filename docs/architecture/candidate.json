  "cards": [
    {
      "dot": "cyan",
      "title": "Request & data path",
      "items": [
        "Stateless filter chain: rate limit → JWT → path and role authorization",
        "Controllers map DTOs and call domain services; services read and write through JPA repositories",
        "PostgreSQL in prod, H2 under the dev profile; Flyway owns the schema and JPA validates it"
      ]
    },
    {
      "dot": "rose",
      "title": "Authentication & authorization",
      "items": [
        "Login: AuthenticationManager → CustomUserDetailsService → UserService → database",
        "Access and refresh JWTs carry a jti; logout stores both jtis in Redis until they expire",
        "Each authenticated request re-checks the Redis blocklist and reloads user authorities"
      ]
    },
    {
      "dot": "emerald",
      "title": "Async events & percentages",
      "items": [
        "HabitCompletionService publishes CompletionChanged(userId, date) inside the update transaction",
        "ProvisioningTrigger listens AFTER_COMMIT on an @Async thread, creates missing completion rows, then recalculates",
        "Day rate = completed habit points / total points; week rate = mean of PercentageDay rates, each in REQUIRES_NEW"
      ]
    },
    {
      "dot": "amber",
      "title": "Engine & confidence",
      "items": [
        "Startup marks stale job_run rows failed, then runs a full cycle; each cron trigger repeats the full ordered list",
        "Daily, weekly, yearly generators and monthly cleanup jobs persist RUNNING, SUCCESS, FAILED and SKIPPED history",
        "Solid edges are direct Java calls or annotations in the cited sources; dashed edges are Spring-event / @Async hand-offs, also traced but without a direct call",
        "Not drawn, inferred: Redis state is shared across instances, @Async uses Spring's default executor, and SMTP, Actuator and Prometheus are configured but outside the live request or event path"
      ]
    }
  ]
