# Copy this file to .env and fill in real values. Never commit .env.

# ===============================
# Database (PostgreSQL)
# ===============================
# sslmode=disable is for local development only
DB_URL=jdbc:postgresql://localhost:5432/aadati?sslmode=disable
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===============================
# JWT
# ===============================
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=replace_with_a_secure_random_secret

# ===============================
# Default Admin
# ===============================
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace_with_a_strong_password

# ===============================
# Redis
# ===============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===============================
# Mail (Gmail SMTP)
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
# Gmail requires an App Password (2-step verification must be enabled)
MAIL_PASSWORD=your_gmail_app_password

# ===============================
# Server
# ===============================
SERVER_PORT=8082

# ===============================
# CORS
# ===============================
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000

# Active profile
SPRING_PROFILES_ACTIVE=dev